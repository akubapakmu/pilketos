{
    "name": "smp1dawe/pemilihan-osis-2026",
    "description": "Sistem e-voting Pemilihan Ketua dan Wakil Ketua OSIS SMP 1 DAWE 2026 (CodeIgniter 4)",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1",
        "laminas/laminas-escaper": "^2.18",
        "matomo/device-detector": "^6.4",
        "matthiasmullie/minify": "^1.3",
        "phpoffice/phpspreadsheet": "^5.10",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "mikey179/vfsstream": "^1.6.12",
        "phpunit/phpunit": "^10.5.16 || ^11.2"
    },
    "autoload": {
        "psr-4": {
            "CodeIgniter\\": "system/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**",
            "system/ThirdParty/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage"
    }
}
